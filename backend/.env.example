# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in the real values.
# NEVER commit the real ".env" file.
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string used by the API at runtime.
# Use the POOLED string (hostname contains "-pooler").
# Example:
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Neon DIRECT (non-pooled) connection string, used only by Drizzle Kit migrations.
# Neon recommends a direct connection for schema migrations.
# If empty, Drizzle Kit falls back to DATABASE_URL.
# Example:
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=

# Port for the Express API (default 7000).
PORT=7000

# Secret used to sign JWT access tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters long.
JWT_SECRET=b22a6edacad0052af54eb9e3eafcd8a7279208b4116923b56570a481a09d1cca3691549280519864791d622995ed176aac48bed5c3a23fa8fb197139a68d75f4

# How many days a login stays valid (default 7).
JWT_EXPIRES_IN_DAYS=7

# development | test | production
NODE_ENV=development

# The URL of the Vite frontend, used for CORS.
FRONTEND_URL=http://localhost:5173
